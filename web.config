<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for Printer Monitor via HttpPlatformHandler.

  Prerequisites on the server:
    1. Python 3.11+ installed for all users (e.g. C:\Python312).
    2. The HttpPlatformHandler 1.2 IIS module installed.
    3. Dependencies installed into .venv inside this folder:
         C:\Python312\python.exe -m venv .venv
         .venv\Scripts\python.exe -m pip install -r requirements.txt

  Adjust the two paths below if the app does not live in
  C:\inetpub\printer-monitor.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Hand every request to the Python process. -->
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\inetpub\printer-monitor\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --no-access-log"
                  workingDirectory="C:\inetpub\printer-monitor"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\printer-monitor\logs\stdout"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:05:00"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PRINTER_MONITOR_CONFIG"
                             value="C:\inetpub\printer-monitor\config.json" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Uncomment when hosting as a virtual application under a site, so
             the app builds its URLs on the prefix rather than the site root.
             The value must match the virtual application's alias, and be
             appended to the arguments above as: - -root-path /printers
        <environmentVariable name="PRINTER_MONITOR_BASE" value="/printers" />
        -->
      </environmentVariables>
    </httpPlatform>

    <!-- The printer web interfaces are linked, not proxied, so no outbound
         rules are needed. Keep the dashboard out of search engines and stop
         IIS from serving the JSON inventory or the venv directly. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".venv" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="tests" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
